{
  "name": "obsidian-todos-rollup",
  "version": "1.0.2",
  "description": "Every todo in your Obsidian vault in one place, grouped by the note it lives in and ordered by when that note was last updated. Works on desktop and mobile.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "vite --config vite.config.ts",
    "demo": "vite --config vite.config.ts",
    "demo:build": "vite build --config vite.config.ts",
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p tsconfig.build.json && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\" \"demo/**/*.test.ts\"",
    "install-plugin": "node scripts/install.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "lint": "oxlint --deny-warnings",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "todo",
    "todos"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidpeled/Obsidian-TODOS-Rollup-Plugin.git"
  },
  "homepage": "https://github.com/davidpeled/Obsidian-TODOS-Rollup-Plugin#readme",
  "bugs": {
    "url": "https://github.com/davidpeled/Obsidian-TODOS-Rollup-Plugin/issues"
  },
  "author": "David Peled",
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.14.4",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.6"
  }
}
